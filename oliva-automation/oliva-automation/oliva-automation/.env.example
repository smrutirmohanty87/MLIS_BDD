# Copy to .env and fill in from your secure credential store.
# NEVER commit the real .env file.
SF_BASE_URL=https://dualgroup--sitp.sandbox.my.salesforce.com

# Main flow user (UW3) — runs the ENTIRE flow
SF_USERNAME=
SF_PASSWORD=

# UAL approver (UW5) — used ONLY when the quote raises
# "Status cannot be changed as there are outstanding UAL/Carrier Referrals".
# Logged in via a separate browser context just to approve, then closed.
SF_UAL_APPROVER_USERNAME=
SF_UAL_APPROVER_PASSWORD=
