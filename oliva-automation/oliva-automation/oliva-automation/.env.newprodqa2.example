# Config for the Oliva Construction "Renovation" flow on the newprodqa2 sandbox.
# Copy to .env (or export in the shell) and fill from your secure store.
# NEVER commit the real values or the private key.

# --- newprodqa2 sandbox ---
SF_BASE_URL=https://dualgroup--newprodqa2.sandbox.lightning.force.com

# --- JWT bearer auth (bypasses MFA; no passwords needed) ---
# Connected-app consumer key:
SF_JWT_CLIENT_ID=<connected-app consumer key>
# Path to the RSA private key (PEM) whose cert is on the connected app:
SF_JWT_KEY_PATH=/absolute/path/to/automation_server.key
# Token host / audience (sandbox = test.salesforce.com):
SF_JWT_LOGIN_URL=https://test.salesforce.com

# --- Construction users (pre-authorized on the connected app) ---
SF_RENO_UW3_USERNAME=oliva.cons.puw3@dualgroup.com.newprodqa2
SF_RENO_UW5_USERNAME=oliva.cons.puw5@dualgroup.com.newprodqa2
