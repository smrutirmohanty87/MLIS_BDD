# Copy this file to .env and fill in the values.
# These values are read by Playwright at runtime.

# MLIS Broker Portal (Experience Cloud)
MLIS_PORTAL_URL=https://dualgroup--sitp.sandbox.my.site.com/mlisportal/broker-zone

# Salesforce Lightning
SALESFORCE_LIGHTNING_URL=https://dualgroup--sitp.sandbox.lightning.force.com/

# Broker Portal credentials
BROKER_USERNAME=
BROKER_PASSWORD=""

# Salesforce credentials
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=""

# SIT1 prefixed keys (used when TEST_ENV=SIT1)
SIT1_MLIS_PORTAL_URL=https://dualgroup--sit.sandbox.my.site.com/mlisportal/
SIT1_SALESFORCE_LIGHTNING_URL=
SIT1_BROKER_USERNAME=
SIT1_BROKER_PASSWORD=""
SIT1_SALESFORCE_USERNAME=
SIT1_SALESFORCE_PASSWORD=""

# BAUDEV prefixed keys (used when TEST_ENV=BAUDEV)
BAUDEV_MLIS_PORTAL_URL=
BAUDEV_SALESFORCE_LIGHTNING_URL=https://dualgroup--baudev.sandbox.my.salesforce.com/
BAUDEV_BROKER_USERNAME=
BAUDEV_BROKER_PASSWORD=""
BAUDEV_SALESFORCE_USERNAME=p.gurumurthy@dualgroup.com.dualprod.baudev
BAUDEV_SALESFORCE_PASSWORD="!Salesforce123"

# HOTFIX prefixed keys (used when TEST_ENV=HOTFIX)
HOTFIX_MLIS_PORTAL_URL=
HOTFIX_SALESFORCE_LIGHTNING_URL=https://dualgroup--hotfix.sandbox.my.salesforce.com/
HOTFIX_BROKER_USERNAME=
HOTFIX_BROKER_PASSWORD=""
HOTFIX_SALESFORCE_USERNAME=predrag.latinovic@howdengroup.com.hotfix
HOTFIX_SALESFORCE_PASSWORD=""

# Optional alias used by envManager for Salesforce user
SALEFORCE_HOTFIX_ENHANCEDUSER=predrag.latinovic@howdengroup.com.hotfix

# JWT auth configuration for HOTFIX (used when useJwt=true)
SALESFORCE_HOTFIX_JWT_CLIENT_ID=3MVG9HaDtEO2FoLK2gDKcE7gvp5zNAq93v2NcohGhrac7Y3DkXFm3NfoZbnZcfefcPC.fKTU.lwQ02tSwYdZO
# Provide one of the following private key settings:
SALESFORCE_HOTFIX_JWT_PRIVATE_KEY_PATH=
SALESFORCE_HOTFIX_JWT_PRIVATE_KEY=
# Optional; defaults to https://test.salesforce.com if omitted
SALESFORCE_HOTFIX_JWT_LOGIN_URL=https://test.salesforce.com
