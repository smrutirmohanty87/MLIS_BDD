# Copy this file to .env and fill in local/pipeline values.
# Do not commit secrets.
# TEST_ENV defaults to SIT1 when not set.

# ============================================================
# UAT2 ACTIVE ENV (unprefixed fallback used by envManager)
# ============================================================
MLIS_PORTAL_URL=
SALESFORCE_LIGHTNING_URL=
BROKER_USERNAME=
BROKER_PASSWORD=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# Enhanced user aliases (optional but recommended)
SALEFORCE_UAT2_ENHANCEDUSER=
SALEFORCE_UAT2_ENHANCEDUSER_PASSWORD=

# Claims user aliases (used by claims JWT smoke specs)
SALEFORCE_UAT2_CLAIMUSER=
SALEFORCE_UAT2_CLAIMUSER_PASSWORD=

# JWT config for UAT2
SALESFORCE_UAT2_JWT_CLIENT_ID=
SALESFORCE_UAT2_JWT_PRIVATE_KEY_PATH=
SALESFORCE_UAT2_JWT_PRIVATE_KEY=
SALESFORCE_UAT2_JWT_USERNAME=
SALESFORCE_UAT2_JWT_LOGIN_URL=https://test.salesforce.com
SALESFORCE_UAT2_JWT_AUD=https://test.salesforce.com

