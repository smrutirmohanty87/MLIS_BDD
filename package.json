    "test:sanity:edge": "npx playwright test tests/sanity/ --project=chrome --headed --workers=1",
    "test:regression": "npx playwright test tests/regression/ --project=chrome --headed --workers=1",
    "test:regression:chrome": "npx playwright test tests/regression/ --project=chrome --headed --workers=1",
