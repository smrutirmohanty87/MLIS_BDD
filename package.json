    "test:regression:edge": "npx playwright test tests/regression/ --project=chrome --headed --workers=1",
    "test:bdx:intro": "npx playwright test tests/BDX/TC_BDX_001_INTRO_cancel_full_premium_return.spec.ts --project=chrome --headed --workers=1",
